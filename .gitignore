node_modules/
dist/
build/
# Security self-review finding: the old `.env`/`.env.local` pair didn't
# cover a real, easy mistake — a locally-generated test env file (e.g.
# .env.docker-test, made while smoke-testing the Phase 9 deployment stack
# with real random secrets) sat untracked-but-NOT-ignored, one `git add -A`
# away from being committed. Wildcarded, with explicit re-allows for the
# two templates that are meant to be committed.
.env*
!.env.example
!.env.production.example
.docker-test-admin-pw.txt
*.log
coverage/
.turbo/
.DS_Store
Thumbs.db
apps/api/generated/

# Python (services/ocr)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Synthetic OCR test fixtures — regenerated on demand by
# services/ocr/tests/generate_fixtures.py, not committed, so there's never
# any ambiguity about whether a committed image is really synthetic.
services/ocr/tests/fixtures/*.jpg
services/ocr/tests/fixtures/*.png

# Pretrained model weights — converted at Dockerfile build time (see
# services/biometrics/Dockerfile and scripts/convert_minifasnet.py), same
# "not vendored into git" posture as Tesseract's language data being
# installed via apt rather than committed. Path is app/models/, not
# models/ — got this wrong once already (see README's Phase 2 section);
# double-checked against the real on-disk path this time, not just copied
# from memory.
services/biometrics/app/models/
