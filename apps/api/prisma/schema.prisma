// LybID — Phase 0 schema.
// DATABASE_URL (owner role) is used for migrations. The running app connects
// with RUNTIME_DATABASE_URL (the non-owner `lybid_app` role) so that the RLS
// policies created in migration 2_rls_setup actually apply to it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum ApiKeyEnvironment {
  LIVE
  TEST
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum AdminRole {
  PLATFORM_ADMIN
}

enum ApplicantStatus {
  ACTIVE
  ARCHIVED
}

enum DocumentType {
  PASSPORT
  BIRTH_CERTIFICATE
  // Phase 2: a live selfie photo. Never OCR'd — DocumentsService.upload()
  // only enqueues extraction for PASSPORT/BIRTH_CERTIFICATE, so a SELFIE
  // Document stays in UPLOADED status permanently. Processing happens via
  // a separate BiometricCheck, not this row's own status machine.
  SELFIE
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  EXTRACTED
  FAILED
  NEEDS_REVIEW
}

enum ExtractionStatus {
  COMPLETED
  FAILED
}

enum BiometricCheckStatus {
  PROCESSING
  COMPLETED
  FAILED
  NEEDS_REVIEW
}

enum LivenessVerdict {
  LIVE
  SPOOF
  UNKNOWN
}

enum FaceMatchVerdict {
  MATCH
  NO_MATCH
  UNKNOWN
}

enum BusinessStatus {
  ACTIVE
  ARCHIVED
}

enum BusinessDocumentType {
  COMMERCIAL_REGISTRATION
  CHAMBER_OF_COMMERCE
  TAX_ID
}

enum DecisionStatus {
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  apiKeys    ApiKey[]
  applicants Applicant[]
  businesses Business[]

  @@map("tenants")
}

model ApiKey {
  id        String            @id @default(uuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id])

  // First ~8 chars of the token, stored in the clear for lookup/display
  // (e.g. "lyb_live_a1b2c3d4"). Never enough entropy to be usable alone.
  keyPrefix String            @unique

  // HMAC-SHA256(API_KEY_PEPPER, fullToken) — the token has 256 bits of
  // entropy, so a fast keyed hash is correct here (not bcrypt, which is
  // for low-entropy human passwords).
  keyHash   String

  environment     ApiKeyEnvironment
  scopes          String[]          @default([])
  status          ApiKeyStatus      @default(ACTIVE)
  expiresAt       DateTime?
  createdByAdminId String?
  createdByAdmin  PlatformAdminUser? @relation(fields: [createdByAdminId], references: [id])
  lastUsedAt      DateTime?
  createdAt       DateTime          @default(now())
  revokedAt       DateTime?

  @@index([tenantId])
  @@map("api_keys")
}

model PlatformAdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(PLATFORM_ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  issuedApiKeys ApiKey[]

  @@map("platform_admin_users")
}

// Phase 1: an individual being verified. Bank-declared identity fields are
// for the bank's own record-keeping only — never compared against OCR
// results or used in decisioning (that's Phase 4 scope).
model Applicant {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  environment ApiKeyEnvironment

  externalId  String?
  firstName   String?
  lastName    String?
  dateOfBirth DateTime?

  status    ApplicantStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  // Phase 4: denormalized latest decision status, updated in the same
  // transaction as each new ApplicantDecision row — same "current state on
  // the parent, full history in a child table" shape as Document.status +
  // DocumentExtraction. Exists so the review queue (?decisionStatus=
  // NEEDS_REVIEW on GET /v1/applicants) is a cheap indexed filter instead
  // of a latest-row-per-group query. Null until a first decision exists.
  latestDecisionStatus DecisionStatus?

  documents       Document[]
  biometricChecks BiometricCheck[]
  decisions       ApplicantDecision[]

  @@index([tenantId])
  @@map("applicants")
}

// A single uploaded document (passport or birth certificate) belonging to
// an Applicant. Libyan banks require both document types per applicant.
model Document {
  id          String       @id @default(uuid())
  tenantId    String
  applicantId String
  applicant   Applicant    @relation(fields: [applicantId], references: [id])
  environment ApiKeyEnvironment

  type   DocumentType
  status DocumentStatus @default(UPLOADED)

  storageKey       String
  originalFilename String
  mimeType         String
  fileSizeBytes    Int
  sha256           String

  uploadedAt  DateTime  @default(now())
  processedAt DateTime?

  extractions DocumentExtraction[]

  // Opposite sides of BiometricCheck's two named relations to this model —
  // required by Prisma even though Phase 2 has no query path that reads
  // these arrays (nothing needs "which biometric checks used this
  // document" from the Document side yet).
  biometricChecksAsSelfie    BiometricCheck[] @relation("BiometricCheckSelfie")
  biometricChecksAsReference BiometricCheck[] @relation("BiometricCheckReference")

  @@index([tenantId])
  @@index([applicantId])
  @@index([sha256])
  @@map("documents")
}

// One OCR attempt against a Document. Kept separate from Document (not
// columns on it) so re-extraction attempts have independent history — the
// "current" extraction for a document is just the most recent row
// (orderBy createdAt desc, take 1), not a separate flag to keep in sync.
model DocumentExtraction {
  id          String   @id @default(uuid())
  tenantId    String
  documentId  String
  document    Document @relation(fields: [documentId], references: [id])
  environment ApiKeyEnvironment

  engine  String
  rawText String?

  // Structured key/value fields with per-field confidence, e.g.
  // [{ "name": "surname", "value": "AL-FTAISI", "confidence": 0.94 }, ...]
  fields Json?

  overallConfidence Float?
  status            ExtractionStatus
  createdAt         DateTime         @default(now())

  @@index([tenantId])
  @@index([documentId])
  @@map("document_extractions")
}

// Phase 2: one liveness + face-match attempt comparing a selfie against a
// reference document (normally the applicant's passport). Compute-result
// record only — no reviewedBy/reviewNotes or other manual-review-workflow
// fields, that's Phase 4's scope, same posture as DocumentExtraction.
model BiometricCheck {
  id          String            @id @default(uuid())
  tenantId    String
  applicant   Applicant         @relation(fields: [applicantId], references: [id])
  applicantId String
  environment ApiKeyEnvironment

  selfieDocumentId    String
  selfieDocument      Document @relation("BiometricCheckSelfie", fields: [selfieDocumentId], references: [id])
  referenceDocumentId String
  referenceDocument   Document @relation("BiometricCheckReference", fields: [referenceDocumentId], references: [id])

  // The single field decisioning gates on later — mirrors Document.status
  // exactly (COMPLETED is the "both checks confidently good" terminal
  // state, like EXTRACTED; NEEDS_REVIEW is the below-threshold catch-all).
  // livenessVerdict/faceMatchVerdict below are detail, not the gate — this
  // field is what always reflects the composed pass/fail so nothing
  // downstream has to recompute that itself.
  status BiometricCheckStatus @default(PROCESSING)

  livenessScore    Float?
  livenessVerdict  LivenessVerdict?
  faceMatchScore   Float?
  faceMatchVerdict FaceMatchVerdict?

  // e.g. "dlib-resnet-v1+minifasnet-v2" — mirrors DocumentExtraction.engine
  engine String?
  // Includes the thresholds used — records which policy produced a given
  // historical verdict, same audit-trail role as DocumentExtraction.fields.
  rawResult Json?

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([tenantId])
  @@index([applicantId])
  @@map("biometric_checks")
}

// Phase 3: a business being verified (KYB — "Know Your Business"), separate
// from Applicant (a person). Deliberately a new top-level entity, created
// directly by a tenant, not nested under an Applicant — a business isn't a
// person, so forcing it under Applicant would be a misfit. Bank-declared
// fields are for record-keeping only, same posture as Applicant's.
model Business {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  environment ApiKeyEnvironment

  externalId                   String?
  legalName                    String?
  commercialRegistrationNumber String?

  status    BusinessStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  // Phase 4: mirrors Applicant.latestDecisionStatus exactly — see its
  // comment for the full explanation.
  latestDecisionStatus DecisionStatus?

  documents BusinessDocument[]
  decisions BusinessDecision[]

  @@index([tenantId])
  @@map("businesses")
}

// A single uploaded business document (commercial registration, chamber of
// commerce, or tax ID) belonging to a Business. Deliberately a separate
// table from Document rather than a generalized/nullable-FK reuse of it —
// see the Phase 3 plan for why (Document.applicantId is a required FK on an
// already-migrated, RLS-hardened, tested table; Phase 2's BiometricCheck
// faced the identical fork and also chose a new table over modifying
// Document).
model BusinessDocument {
  id          String               @id @default(uuid())
  tenantId    String
  businessId  String
  business    Business             @relation(fields: [businessId], references: [id])
  environment ApiKeyEnvironment

  type   BusinessDocumentType
  // Reuses Document's own DocumentStatus enum — its values (UPLOADED,
  // PROCESSING, etc.) are generic, nothing applicant-specific about them.
  status DocumentStatus @default(UPLOADED)

  storageKey       String
  originalFilename String
  mimeType         String
  fileSizeBytes    Int
  sha256           String

  uploadedAt  DateTime  @default(now())
  processedAt DateTime?

  extractions BusinessDocumentExtraction[]

  @@index([tenantId])
  @@index([businessId])
  @@index([sha256])
  @@map("business_documents")
}

// One OCR attempt against a BusinessDocument — mirrors DocumentExtraction
// exactly, including reusing its ExtractionStatus enum.
model BusinessDocumentExtraction {
  id          String           @id @default(uuid())
  tenantId    String
  documentId  String
  document    BusinessDocument @relation(fields: [documentId], references: [id])
  environment ApiKeyEnvironment

  engine  String
  rawText String?
  fields  Json?

  overallConfidence Float?
  status            ExtractionStatus
  createdAt         DateTime         @default(now())

  @@index([tenantId])
  @@index([documentId])
  @@map("business_document_extractions")
}

// Phase 4: one decisioning attempt for an Applicant — append-only history,
// same shape as DocumentExtraction relative to Document ("current" is just
// the most recent row by createdAt, mirrored onto Applicant.latestDecisionStatus
// for cheap filtering). Produced either by an automatic decide() call or by
// a human's manual review action (reviewerId/reviewNotes set only for the
// latter) — see the Phase 4 plan for why REJECTED is reachable only via
// manual review, never the automatic rule.
model ApplicantDecision {
  id          String            @id @default(uuid())
  tenantId    String
  applicantId String
  applicant   Applicant         @relation(fields: [applicantId], references: [id])
  environment ApiKeyEnvironment

  status DecisionStatus

  // Audit trail of what fed the decision (which checks, their statuses) —
  // same audit-trail role as DocumentExtraction.fields / BiometricCheck.rawResult.
  reasoning Json

  // Set only when this row resulted from a manual review action. No
  // bank-staff identity system exists yet (see the Phase 4 plan) —
  // reviewerId is free text the tenant's own caller supplies, same posture
  // as ApiKey.createdByAdminId elsewhere but without an FK.
  reviewerId  String?
  reviewNotes String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([applicantId])
  @@map("applicant_decisions")
}

// Mirrors ApplicantDecision exactly, for Business.
model BusinessDecision {
  id          String            @id @default(uuid())
  tenantId    String
  businessId  String
  business    Business          @relation(fields: [businessId], references: [id])
  environment ApiKeyEnvironment

  status DecisionStatus

  reasoning Json

  reviewerId  String?
  reviewNotes String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([businessId])
  @@map("business_decisions")
}

// Schema-only for Phase 0 — no retention/deletion policy yet (that is a
// Phase 8 decision). Written to on tenant create and api-key issue/revoke.
model AuditLog {
  id         String   @id @default(uuid())
  actorType  String
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@map("audit_logs")
}
