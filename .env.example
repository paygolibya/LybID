# Postgres owner/migration role — used ONLY by `prisma migrate` and the seed script.
# This role owns the tables, so Row-Level Security policies do NOT apply to it.
DATABASE_URL="postgresql://lybid_owner:lybid_owner_dev_password@localhost:5432/lybid?schema=public"

# Postgres runtime role — used by the running API. Non-owner, so RLS policies apply to it.
# Created by the migration in apps/api/prisma/migrations/*_rls_setup.
RUNTIME_DATABASE_URL="postgresql://lybid_app:lybid_app_dev_password@localhost:5432/lybid?schema=public"
RUNTIME_DB_PASSWORD="lybid_app_dev_password"

NODE_ENV="development"
PORT=3000

# Signs platform admin JWTs. Generate a real random value for anything beyond local dev.
JWT_SECRET="dev-only-change-me-jwt-secret"
JWT_EXPIRES_IN="8h"

# HMAC pepper for API key hashing (server-side secret, never stored in the DB).
API_KEY_PEPPER="dev-only-change-me-api-key-pepper"

# Bootstraps the first PlatformAdminUser via the Prisma seed script.
ADMIN_BOOTSTRAP_EMAIL="admin@marsa.ly"
ADMIN_BOOTSTRAP_PASSWORD="change-me-on-first-login"
