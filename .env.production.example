# Production template for docker-compose.prod.yml — distinct from the
# dev-oriented .env.example (whose values are working local defaults on
# purpose). Every placeholder below marked GENERATE must actually be
# regenerated: main.ts's assertProductionSecretsAreNotPlaceholders()
# refuses to boot with NODE_ENV=production if JWT_SECRET, API_KEY_PEPPER,
# APPLICANT_TOKEN_SECRET, or ADMIN_BOOTSTRAP_PASSWORD still literally
# equal .env.example's own placeholder strings — this file uses
# different-looking placeholders so that check can't accidentally pass
# on an unedited copy of this file either; generate real values for all
# of them regardless. A reasonable way to generate a random secret:
#   openssl rand -hex 32

# The owner-role password embedded in DATABASE_URL below MUST exactly
# match POSTGRES_OWNER_PASSWORD — see docker-compose.prod.yml's postgres
# service comment for why this is a separate variable. GENERATE both,
# keep them equal.
POSTGRES_OWNER_PASSWORD="GENERATE-a-real-password-and-copy-it-into-DATABASE_URL-below-too"
DATABASE_URL="postgresql://lybid_owner:GENERATE-a-real-password-and-copy-it-into-DATABASE_URL-below-too@postgres:5432/lybid?schema=public"

# The lybid_app runtime role is created by the RLS-setup migration using
# exactly this password — GENERATE a real one; RUNTIME_DATABASE_URL must
# embed the same value.
RUNTIME_DB_PASSWORD="GENERATE-a-real-password"
RUNTIME_DATABASE_URL="postgresql://lybid_app:GENERATE-a-real-password@postgres:5432/lybid?schema=public"

NODE_ENV="production"
PORT=3000

# GENERATE — refuses to boot in production if left as .env.example's
# placeholder (see assertProductionSecretsAreNotPlaceholders).
JWT_SECRET="GENERATE-with-openssl-rand--hex-32"
JWT_EXPIRES_IN="8h"

# GENERATE.
API_KEY_PEPPER="GENERATE-with-openssl-rand--hex-32"

# GENERATE — deliberately a separate secret from JWT_SECRET.
APPLICANT_TOKEN_SECRET="GENERATE-with-openssl-rand--hex-32"
APPLICANT_TOKEN_EXPIRES_IN="30m"

# The email is a real operational choice, not a secret to generate —
# whoever should actually own the first admin login. The password:
# GENERATE a real one and change it on first login regardless (the seed
# script only ever runs once, at first deploy).
ADMIN_BOOTSTRAP_EMAIL="ops@yourbank.example"
ADMIN_BOOTSTRAP_PASSWORD="GENERATE-a-real-password"

REDIS_URL="redis://redis:6379"
OCR_SERVICE_URL="http://ocr:8000"
BIOMETRICS_SERVICE_URL="http://biometrics:8001"

MINIO_ENDPOINT="minio"
MINIO_PORT=9000
MINIO_USE_SSL=false
# GENERATE both — these become MinIO's own root credentials too (see
# docker-compose.prod.yml's minio service), not just an app-level config
# value.
MINIO_ACCESS_KEY="GENERATE-a-real-access-key"
MINIO_SECRET_KEY="GENERATE-a-real-secret-key"
MINIO_BUCKET="lybid-documents"

# Build-time only (apps/admin-dashboard/Dockerfile's VITE_API_BASE_URL
# ARG) — the origin operators' own browsers will reach the API at, not a
# container-network address. Defaults to http://localhost:3000 in
# docker-compose.prod.yml if unset; set this to your real API origin
# (behind your own reverse proxy/TLS) before building the admin-dashboard
# image for anything beyond a same-machine smoke test.
ADMIN_DASHBOARD_API_BASE_URL="https://api.yourbank.example"
